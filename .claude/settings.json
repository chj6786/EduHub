{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./gradlew test *)",
      "Bash(./gradlew build *)",
      "Bash(./gradlew spotlessApply *)",
      "Bash(./gradlew spotlessCheck *)",
      "Bash(npm test *)",
      "Bash(npm run build *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "PowerShell(.\\gradlew.bat test *)",
      "PowerShell(.\\gradlew.bat build *)",
      "PowerShell(.\\gradlew.bat spotlessApply *)",
      "PowerShell(.\\gradlew.bat spotlessCheck *)",
      "PowerShell(npm test *)",
      "PowerShell(npm run build *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git show *)",
      "PowerShell(git branch *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(docker *)",
      "PowerShell(git push *)",
      "PowerShell(docker *)"
    ],
    "deny": [
      "Read(/.env)",
      "Read(/**/.env)",
      "Read(/**/application-prod*.yml)",
      "Edit(/.env)",
      "Edit(/**/.env)",
      "Edit(/**/application-prod*.yml)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(*flywayClean*)",
      "Bash(ssh *)",
      "Bash(psql *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "PowerShell(*flywayClean*)",
      "PowerShell(ssh *)",
      "PowerShell(psql *)"
    ]
  }
}
